{
  "compilerOptions": {
    "noUncheckedSideEffectImports": false,
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "types": [],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@nimbalyst/extension-sdk/file-tree": ["../../extension-sdk/src/fileDirectoryTree.ts"],
      "@nimbalyst/extension-sdk/file-mask": ["../../extension-sdk/src/fileMask.ts"],
      "@nimbalyst/extension-sdk/git-operation-log": ["../../extension-sdk/src/gitOperationLog.ts"]
    }
  },
  "include": ["src"]
}
