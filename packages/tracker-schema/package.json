{
  "name": "@nimbalyst/tracker-schema",
  "version": "0.1.0",
  "description": "Tracker schema models, YAML parsing, and schema change classification",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./labelRegistryAuthoring": {
      "types": "./dist/labelRegistryAuthoring.d.ts",
      "import": "./dist/labelRegistryAuthoring.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "node ../../scripts/tsc-native.mjs -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@nimbalyst/tracker-core": "workspace:*",
    "js-yaml": "^4.3.2"
  }
}
