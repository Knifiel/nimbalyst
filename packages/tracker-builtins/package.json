{
  "name": "@nimbalyst/tracker-builtins",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Worker-safe built-in tracker type catalog plus the schema-patch and inverse-relationship helpers, for hosts with no runtime (the collab worker).",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "types"
  ],
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node scripts/build.mjs --catalog-only",
    "build": "node scripts/build.mjs",
    "typecheck": "node ../../scripts/tsc-native.mjs --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^6.0.3"
  }
}
